<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Pragmatic ruleset. Two tiers:
    severity=error   -> real bugs, FAILS the Jenkins "Lint" stage
    severity=warning -> style, reported only (shows in console + SonarQube)
  Google/Sun checks are too noisy for an existing codebase; teams usually start like this and tighten.
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <module name="FileTabCharacter"/>
    <module name="LineLength">
        <property name="max" value="140"/>
    </module>

    <module name="TreeWalker">
        <!-- ===== error: fail the build ===== -->
        <module name="EmptyCatchBlock"><property name="severity" value="error"/></module>
        <module name="EqualsHashCode"><property name="severity" value="error"/></module>
        <module name="EmptyStatement"><property name="severity" value="error"/></module>
        <module name="StringLiteralEquality"><property name="severity" value="error"/></module>
        <module name="FallThrough"><property name="severity" value="error"/></module>
        <module name="UnusedImports"><property name="severity" value="error"/></module>
        <module name="RedundantImport"><property name="severity" value="error"/></module>

        <!-- ===== warning: report only ===== -->
        <module name="AvoidStarImport"/>
        <module name="NeedBraces"/>
        <module name="MissingSwitchDefault"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="ConstantName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="TypeName"/>
        <module name="ParameterNumber"><property name="max" value="7"/></module>
        <module name="MethodLength"><property name="max" value="80"/></module>
    </module>
</module>
